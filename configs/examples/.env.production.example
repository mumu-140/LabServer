# LabServer Production Configuration Template
# Copy this file to .env (do not commit real .env to Git)

# Secret key for session security (generate with: openssl rand -hex 32)
LABSERVER_SECRET_KEY=replace_with_secure_random_hex_secret

# Lab display timezone (defaults to Asia/Shanghai)
LABSERVER_TIMEZONE=Asia/Shanghai

# Set to true when running behind an HTTPS reverse proxy (Caddy / CF Tunnel)
LABSERVER_COOKIE_SECURE=false

# Host port publishing (strictly loopback 127.0.0.1)
LABSERVER_WEB_PORT=18280
LABSERVER_CORE_PORT=18281

# Data directory path on host (defaults to ./data)
LABSERVER_DATA_DIR=../data
